<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp">

    <TextView
        android:id="@+id/text_owner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Wall-clock time of the last sync attempt (success or failure), distinct from
         text_data_through below, specifically so it's possible to tell "did a sync just run at
         all" apart from "how fresh is the data", which used to be conflated into one timestamp
         that barely moved day to day (it showed the data cutoff, not the attempt time). -->
    <TextView
        android:id="@+id/text_last_sync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/text_owner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_data_through"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/text_last_sync"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fixed position, independent of how long the status text below it gets, so repeat
         taps always land in the same place regardless of sync result. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_sync_now"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/button_sync_now"
        app:layout_constraintTop_toBottomOf="@id/text_data_through"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/button_sync_now"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Placed last / below everything else so toggling its visibility (gone once a key has
         been imported) never shifts the position of button_sync_now or anything above it. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_import_key"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/button_import_key"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/text_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Resets the sync cursor and re-reads everything Health Connect currently retains, safe
         thanks to the source_record_id dedup backstop in DriveUploader (already-synced days
         just get filtered out, nothing duplicates). Needed after adding a new metric type: the
         shared cursor had already advanced past that metric's whole history from whatever was
         already being tracked, so newly-added metrics otherwise only ever see data from the
         moment they were added onward, silently missing everything Health Connect still has
         from before that. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_resync_history"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/button_resync_history"
        app:layout_constraintTop_toBottomOf="@id/button_import_key"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grants one-time SAF access to wherever Samsung Health's own full-data-export lands
         (Downloads/Samsung Health/samsunghealth_...). HRV and respiratory rate never reach
         Health Connect at all, so this folder is the only way in for those two. Hidden once a
         folder's been picked, same visibility pattern as button_import_key. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_connect_export_folder"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/button_connect_export_folder"
        app:layout_constraintTop_toBottomOf="@id/button_resync_history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Persistent, per-source problem list, distinct from text_status above, which only ever
         reflects the *most recent* sync attempt as a whole. A single metric type failing to
         parse (Samsung changed an export's format, Health Connect has a corrupted stored record)
         is deliberately isolated so it can't fail the overall sync, which means text_status can
         say SUCCESS on every subsequent run even though that one metric has been silently broken
         and un-synced the whole time. This shows every such outstanding problem, keyed by the
         source that's actually broken, and each entry only disappears once that specific source
         succeeds again, not just because a new sync ran. Hidden entirely when nothing's wrong. -->
    <TextView
        android:id="@+id/text_source_warnings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#B00020"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/button_connect_export_folder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
